--- docker-compose.yaml
+++ docker-compose.yaml
@@ -77,3 +77,18 @@
+  cybercover-reports:
+    <<: [*logging, *artemis-build-or-image]
+    command: "uvicorn cybercover_reports.api:app --host 0.0.0.0 --port 5000"
+    env_file: .env
+    environment:
+      PYTHONPATH: /opt
+      CPE_NVD_DIR: /data/cpe-nvd
+    ports:
+      - "127.0.0.1:5001:5000"
+    volumes:
+      - "${CYBERCOVER_REPORTS_DIR:-./cybercover_reports}/cybercover_reports:/opt/cybercover_reports:ro"
+      - "${DOCKER_COMPOSE_ADDITIONAL_SHARED_DIRECTORY:-./shared}:/shared/"
+      - cpe-nvd-data:/data/cpe-nvd:ro
+    restart: always
+
   cleanup:
     <<: [*logging, *artemis-build-or-image]
     command: "bash -c 'alembic upgrade head && python3 -m artemis.cleanup'"
